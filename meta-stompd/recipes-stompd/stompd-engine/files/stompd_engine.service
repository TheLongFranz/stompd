[Unit]
Description=stompd-engine audio processing service

[Service]
Type=exec
User=stompd-engine
Group=stompd

SupplementaryGroups=audio
RuntimeDirectory=stompd
RuntimeDirectoryMode=0750
UMask=0007
LimitRTPRIO=90
LimitMEMLOCK=infinity
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

ExecStartPre=/bin/sh -c 'echo uptime=$$(cut -d" " -f1 /proc/uptime); id; echo rtprio=$$(ulimit -r) memlock=$$(ulimit -l)'
ExecStart=/usr/bin/stompd

Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target