[Unit]
Description=stompd
After=stompd-engine.service

[Service]
Type=exec
User=stompd-ui
Group=stompd

ExecStart=/usr/bin/stompd-ui
SupplementaryGroups=video input
Restart=always
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

Environment=LANG=C.UTF-8
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_KMS_CONFIG=/etc/eglfs-kms.json

LimitRTPRIO=95
LimitMEMLOCK=infinity

ExecStartPre=/bin/sh -c 'echo uptime=$$(cut -d" " -f1 /proc/uptime); id; echo rtprio=$$(ulimit -r) memlock=$$(ulimit -l)'

[Install]
WantedBy=multi-user.target
